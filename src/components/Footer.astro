      </div>
    </div>

    <!-- Bottom copyright row -->
    <div
      class="mt-16 pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-white"
    >
      <div>
        Copyright © {currentYear}
        <span><a href="/" class="hover:underline">xedulichgiahuy.com</a></span>,
        Design by <a
          href="https://kieugia.vn"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:underline font-semibold text-brand-yellow"
          >Kiều Gia Group</a
        >
      </div>
      <div class="text-center md:text-right text-white">
        Nội dung báo giá chỉ để tham khảo, quý khách vui lòng liên hệ trực tiếp
        qua hotline.
      </div>
    </div>
  </div>
</footer>
