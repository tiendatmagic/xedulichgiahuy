---
const currentYear = new Date().getFullYear();
---

<footer
  id="lien-he"
  class="bg-brand text-white pt-16 pb-8 border-t border-white/10 relative overflow-hidden scroll-mt-24"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Col 1: Company Info -->
      <div class="flex flex-col gap-4">
        <div
          class="bg-white p-2 rounded-xl inline-block self-start shadow-premium border border-white/10"
        >
          <img
            src="/uploads/logo.png"
            alt="Xe du lịch Gia Huy"
            class="h-16 w-auto object-contain rounded-lg"
          />
        </div>
        <h4
          class="text-white font-extrabold text-base tracking-wide uppercase mt-2"
        >
          Công Ty Xe Du Lịch Gia Huy
        </h4>
        <ul class="flex flex-col gap-2.5 text-sm md:text-[15px] text-white/80">
          <li class="flex items-start gap-2.5">
            <i class="fa-solid fa-location-dot text-brand-yellow mt-1 shrink-0"
            ></i>
            <span>Vĩnh Lương, Nha Trang, Khánh Hòa</span>
          </li>
          <li class="flex items-center gap-2.5">
            <i class="fa-solid fa-phone text-brand-yellow shrink-0"></i>
            <a
              href="tel:0935373577"
              class="hover:text-brand-yellow transition-colors font-semibold text-white"
              >0935.373.577</a
            >
          </li>
          <li class="flex items-center gap-2.5">
            <i class="fa-solid fa-envelope text-brand-yellow shrink-0"></i>
            <a
              href="mailto:xedulichgiahuy79@gmail.com"
              class="hover:text-brand-yellow transition-colors text-white"
              >xedulichgiahuy79@gmail.com</a
            >
          </li>
          <li class="flex items-center gap-2.5">
            <i class="fa-solid fa-globe text-brand-yellow shrink-0"></i>
            <a
              href="https://xedulichgiahuy.com"
              class="hover:text-brand-yellow transition-colors text-white"
              >www.xedulichgiahuy.com</a
            >
          </li>
        </ul>
      </div>

      <!-- Col 2: Dịch vụ -->
      <div>
        <h4
          class="text-white font-extrabold text-sm tracking-widest uppercase mb-5 relative pb-2 after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-10 after:bg-brand-yellow"
        >
          Dịch vụ
        </h4>
        <ul class="flex flex-col gap-3 text-sm md:text-[15px] text-white/80">
          <li>
            <a
              href="###"
              class="hover:text-brand-yellow hover:translate-x-1 inline-block transition-all duration-300 text-white"
            >
              <i
                class="fa-solid fa-chevron-right text-xs text-brand-yellow mr-2"
              ></i>Cho thuê xe tại Nha Trang
            </a>
          </li>
          <li>
            <a
              href="###"
              class="hover:text-brand-yellow hover:translate-x-1 inline-block transition-all duration-300 text-white"
            >
              <i
                class="fa-solid fa-chevron-right text-xs text-brand-yellow mr-2"
              ></i>Cho thuê xe đi Đà Lạt
            </a>
          </li>
          <li>
            <a
              href="###"
              class="hover:text-brand-yellow hover:translate-x-1 inline-block transition-all duration-300 text-white"
            >
              <i
                class="fa-solid fa-chevron-right text-xs text-brand-yellow mr-2"
              ></i>Cho thuê xe đi Cam Ranh
            </a>
          </li>
          <li>
            <a
