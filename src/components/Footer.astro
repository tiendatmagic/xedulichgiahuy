---
const currentYear = new Date().getFullYear();
---

<footer
  class="bg-slate-100 text-slate-600 pt-16 pb-8 border-t border-slate-200 relative overflow-hidden"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Col 1: Company Info -->
      <div class="flex flex-col gap-4">
        <div
          class="bg-white p-2 rounded-xl inline-block self-start shadow-premium border border-slate-200/50"
        >
          <img
            src="/uploads/logo.png"
            alt="Xe du lịch Gia Huy"
            class="h-8 w-auto object-contain"
          />
        </div>
        <h4
          class="text-slate-900 font-extrabold text-base tracking-wide uppercase mt-2"
        >
          Công Ty Xe Du Lịch Gia Huy
        </h4>
        <ul class="flex flex-col gap-2.5 text-sm md:text-[15px]">
          <li class="flex items-start gap-2.5">
            <i class="fa-solid fa-location-dot text-brand mt-1 shrink-0"></i>
            <span>Vĩnh Lương, Nha Trang, Khánh Hòa</span>
          </li>
          <li class="flex items-center gap-2.5">
            <i class="fa-solid fa-phone text-brand shrink-0"></i>
            <a
              href="tel:0935373577"
              class="hover:text-brand transition-colors font-semibold"
              >0935.373.577</a
            >
          </li>
          <li class="flex items-center gap-2.5">
            <i class="fa-solid fa-envelope text-brand shrink-0"></i>
            <a
              href="mailto:xedulichgiahuy79@gmail.com"
              class="hover:text-brand transition-colors"
              >xedulichgiahuy79@gmail.com</a
            >
          </li>
          <li class="flex items-center gap-2.5">
            <i class="fa-solid fa-globe text-brand shrink-0"></i>
            <a
              href="https://xedulichgiahuy.com"
              class="hover:text-brand transition-colors"
              >www.xedulichgiahuy.com</a
            >
          </li>
        </ul>
      </div>

      <!-- Col 2: Dịch vụ -->
      <div>
        <h4
          class="text-slate-900 font-extrabold text-sm tracking-widest uppercase mb-5 relative pb-2 after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-10 after:bg-brand"
        >
          Dịch vụ
        </h4>
        <ul class="flex flex-col gap-3 text-sm md:text-[15px]">
          <li>
            <a
              href="###"
              class="hover:text-brand hover:translate-x-1 inline-block transition-all duration-300"
            >
              <i class="fa-solid fa-chevron-right text-xs text-brand/60 mr-2"
              ></i>Cho thuê xe tại Nha Trang
            </a>
          </li>
          <li>
            <a
              href="###"
              class="hover:text-brand hover:translate-x-1 inline-block transition-all duration-300"
            >
              <i class="fa-solid fa-chevron-right text-xs text-brand/60 mr-2"
              ></i>Cho thuê xe đi Đà Lạt
            </a>
          </li>
          <li>
            <a
              href="###"
              class="hover:text-brand hover:translate-x-1 inline-block transition-all duration-300"
            >
              <i class="fa-solid fa-chevron-right text-xs text-brand/60 mr-2"
              ></i>Cho thuê xe đi Cam Ranh
