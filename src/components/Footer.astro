              <i
                class="fa-solid fa-chevron-right text-xs text-brand-yellow mr-2"
              ></i>Cho thuê xe đi Phú Yên
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Cho thuê -->
      <div>
        <h4
          class="text-white font-extrabold text-sm tracking-widest uppercase mb-5 relative pb-2 after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-10 after:bg-brand-yellow"
        >
          Cho thuê xe
        </h4>
        <ul class="flex flex-col gap-3 text-sm md:text-[15px] text-white/80">
          <li>
            <a
              href="###"
              class="hover:text-brand-yellow hover:translate-x-1 inline-block transition-all duration-300 text-white"
            >
              <i
                class="fa-solid fa-chevron-right text-xs text-brand-yellow mr-2"
              ></i>Cho thuê xe 4, 7 chỗ
            </a>
          </li>
          <li>
            <a
              href="###"
              class="hover:text-brand-yellow hover:translate-x-1 inline-block transition-all duration-300 text-white"
            >
              <i
                class="fa-solid fa-chevron-right text-xs text-brand-yellow mr-2"
              ></i>Cho thuê xe 16 chỗ
            </a>
          </li>
          <li>
            <a
              href="###"
              class="hover:text-brand-yellow hover:translate-x-1 inline-block transition-all duration-300 text-white"
            >
              <i
                class="fa-solid fa-chevron-right text-xs text-brand-yellow mr-2"
              ></i>Cho thuê xe 29 chỗ
            </a>
          </li>
          <li>
            <a
              href="###"
              class="hover:text-brand-yellow hover:translate-x-1 inline-block transition-all duration-300 text-white"
            >
              <i
                class="fa-solid fa-chevron-right text-xs text-brand-yellow mr-2"
              ></i>Cho thuê xe 35, 45 chỗ
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Liên kết ngoài -->
      <div>
        <h4
          class="text-white font-extrabold text-sm tracking-widest uppercase mb-5 relative pb-2 after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-10 after:bg-brand-yellow"
        >
          Liên kết đối tác
        </h4>
        <ul class="flex flex-col gap-3 text-sm md:text-[15px] text-white/80">
          <li>
            <a
              href="https://www.webnhatrang.vn/"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-brand-yellow hover:translate-x-1 inline-block transition-all duration-300 text-white"
            >
              <i class="fa-solid fa-link text-xs text-brand-yellow mr-2"
              ></i>Thiết kế Website Nha Trang
            </a>
          </li>
          <li>
            <a
              href="https://ketoanthuecat.com/"
              target="_blank"
              rel="noopener noreferrer"
