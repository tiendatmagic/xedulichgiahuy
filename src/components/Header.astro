---
const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { label: 'Trang chủ', path: '/' },
  { label: 'Giới thiệu', path: '/about/' },
  { label: 'Dịch vụ', path: '/news/dich-vu/' },
  { label: 'Tin tức', path: '/news/tin-tuc/' },
  { label: 'Liên hệ', path: '/contact/' },
];
---

<header id="main-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300 bg-white/85 border-b border-slate-200/50 backdrop-blur-md shadow-premium">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 md:h-20 items-center justify-between gap-4">
      
      <!-- Logo Left -->
      <a href="/" class="flex shrink-0 items-center gap-2">
        <img src="/uploads/logo.png" alt="Xe du lịch Gia Huy" class="h-10 md:h-12 w-auto object-contain transition-transform duration-300 hover:scale-105" />
      </a>
      
      <!-- Nav Middle (Desktop) -->
      <nav class="hidden lg:flex items-center gap-1">
        {navItems.map(item => {
          const isActive = pathname === item.path || (item.path !== '/' && pathname.startsWith(item.path));
          return (
            <a 
              href={item.path} 
              class={`px-4 py-2 text-[15px] font-medium rounded-lg transition-all duration-300 ${
                isActive 
                  ? 'text-brand bg-brand/5 shadow-[inset_0_0_0_1px_rgba(20,87,255,0.1)]' 
                  : 'text-slate-600 hover:text-brand hover:bg-slate-50'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>
      
      <!-- Actions Right (Desktop & Mobile) -->
      <div class="flex items-center gap-3">
        <!-- Partner Seal (Desktop) -->
        <div class="hidden sm:flex items-center gap-1.5 bg-slate-100/80 border border-slate-200/50 px-3 py-1 rounded-full text-[11px] text-slate-500 font-medium">
          <img src="/uploads/iso.png" alt="ISO" class="h-4 w-4" />
          <span>Đối tác <a href="https://kigi.vn/" target="_blank" class="text-brand font-semibold hover:underline">KIGI Group</a></span>
        </div>

        <!-- Hotline CTA (Desktop) -->
        <a href="tel:0935373577" class="hidden md:inline-flex items-center gap-2 bg-brand-gradient hover:bg-brand-glow text-white text-sm font-semibold px-5 py-2.5 rounded-xl btn-glow shadow-premium transition-all duration-300">
          <i class="fa-solid fa-phone animate-pulse"></i>
          <span>Đặt Xe: 0935.37.3577</span>
        </a>
        
        <!-- Hamburger Menu Button (Mobile) -->
        <button id="mobile-menu-btn" class="lg:hidden p-2 text-slate-600 hover:text-brand transition-colors rounded-lg hover:bg-slate-50" aria-label="Mở menu">
          <i class="fa-solid fa-bars text-xl"></i>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Overlay -->
  <div id="drawer-overlay" class="fixed inset-0 z-50 bg-slate-900/60 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"></div>

  <!-- Mobile Drawer Menu -->
  <div id="drawer-menu" class="fixed inset-y-0 right-0 z-50 w-72 max-w-sm bg-white p-6 shadow-2xl translate-x-full transition-transform duration-300 ease-in-out lg:hidden">
    <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
      <img src="/uploads/logo.png" alt="Xe du lịch Gia Huy" class="h-8 w-auto object-contain" />
      <button id="drawer-close-btn" class="p-2 text-slate-500 hover:text-brand transition-colors rounded-lg hover:bg-slate-50" aria-label="Đóng menu">
        <i class="fa-solid fa-xmark text-xl"></i>
      </button>
    </div>
    
    <nav class="flex flex-col gap-2">
      {navItems.map(item => {
        const isActive = pathname === item.path || (item.path !== '/' && pathname.startsWith(item.path));
        return (
          <a 
            href={item.path} 
            class={`px-4 py-3 text-base font-semibold rounded-xl transition-all duration-300 ${
              isActive 
                ? 'text-brand bg-brand/5 shadow-[inset_0_0_0_1px_rgba(20,87,255,0.1)]' 
                : 'text-slate-600 hover:text-brand hover:bg-slate-50'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
    
    <div class="mt-8 pt-6 border-t border-slate-100">
      <a href="tel:0935373577" class="flex items-center justify-center gap-2 w-full bg-brand-gradient text-white text-base font-bold py-3 rounded-xl shadow-premium">
        <i class="fa-solid fa-phone"></i>
        <span>Gọi đặt xe ngay</span>
      </a>
      
      <div class="mt-6 flex items-center justify-center gap-2 text-xs text-slate-400">
        <img src="/uploads/iso.png" alt="ISO" class="h-4 w-4" />
        <span>Đối tác chính thức của KIGI Group</span>
      </div>
    </div>
  </div>

</header>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const drawerCloseBtn = document.getElementById('drawer-close-btn');
  const drawerOverlay = document.getElementById('drawer-overlay');
  const drawerMenu = document.getElementById('drawer-menu');
  const mainHeader = document.getElementById('main-header');

  function openDrawer() {
    drawerOverlay?.classList.remove('pointer-events-none', 'opacity-0');
    drawerOverlay?.classList.add('opacity-100');
    drawerMenu?.classList.remove('translate-x-full');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawerOverlay?.classList.remove('opacity-100');
    drawerOverlay?.classList.add('pointer-events-none', 'opacity-0');
    drawerMenu?.classList.add('translate-x-full');
    document.body.style.overflow = '';
  }

  mobileMenuBtn?.addEventListener('click', openDrawer);
  drawerCloseBtn?.addEventListener('click', closeDrawer);
  drawerOverlay?.addEventListener('click', closeDrawer);

  // Shrink header on scroll
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      mainHeader?.classList.remove('h-16', 'md:h-20', 'bg-white/85');
      mainHeader?.classList.add('bg-white/95', 'py-1', 'shadow-lg');
    } else {
      mainHeader?.classList.add('h-16', 'md:h-20', 'bg-white/85');
      mainHeader?.classList.remove('bg-white/95', 'py-1', 'shadow-lg');
    }
  });
</script>
