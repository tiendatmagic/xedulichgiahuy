---
const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { label: 'Trang chủ', path: '/', icon: 'fa-house' },
  { label: 'Giới thiệu', path: '###', icon: 'fa-circle-info' },
  { label: 'Dịch vụ', path: '###', icon: 'fa-car-side' },
  { label: 'Tin tức', path: '###', icon: 'fa-newspaper' },
  { label: 'Liên hệ', path: '###', icon: 'fa-headset' },
];
---

<header id="main-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300 bg-white/85 border-b border-slate-200/50 backdrop-blur-md shadow-premium">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative">
    <div class="flex h-16 md:h-20 items-center justify-between gap-4">
      
      <!-- Hamburger Menu Button (Mobile - Left) -->
      <button id="mobile-menu-btn" class="xl:hidden size-11 flex items-center justify-center text-slate-700 hover:text-brand transition-colors rounded-xl hover:bg-slate-50 z-10" aria-label="Mở menu">
        <i class="fa-solid fa-bars text-xl"></i>
      </button>
      
      <!-- Logo Centered on Mobile, Left on Desktop -->
      <a href="/" class="flex shrink-0 items-center gap-2 absolute left-1/2 -translate-x-1/2 xl:static xl:translate-x-0">
        <img src="/uploads/logo.png" alt="Xe du lịch Gia Huy" class="h-5 md:h-7 w-auto object-contain transition-transform duration-300 hover:scale-105" />
      </a>
      
      <!-- Nav Middle (Desktop) -->
      <nav class="hidden xl:flex items-center gap-2 mx-auto">
        {navItems.map(item => {
          const isActive = pathname === item.path || (item.path !== '/' && pathname.startsWith(item.path));
          return (
            <a 
              href={item.path} 
              class={`inline-flex items-center gap-2 rounded-xl px-3.5 xl:px-4 py-2.5 text-base xl:text-[17px] font-bold transition-all duration-300 ${
                isActive 
                  ? 'text-brand bg-brand/5 shadow-[inset_0_0_0_1px_rgba(20,87,255,0.1)]' 
                  : 'text-slate-600 hover:text-brand hover:bg-slate-50'
              }`}
            >
              <span class={`grid size-8 place-items-center rounded-lg transition-colors ${
                isActive ? 'bg-brand text-white' : 'bg-slate-100 text-brand'
              }`}>
                <i class={`fa-solid ${item.icon} text-sm`}></i>
              </span>
              <span>{item.label}</span>
            </a>
          );
        })}
      </nav>
      
      <!-- Actions Right (Desktop & Mobile) -->
      <div class="flex items-center gap-3 z-10">
        <!-- Hotline CTA (Desktop) -->
        <a href="tel:0935373577" class="hidden md:inline-flex items-center gap-2 bg-brand-gradient hover:bg-brand-glow text-white text-sm font-semibold px-5 py-2.5 rounded-xl btn-glow shadow-premium transition-all duration-300">
          <i class="fa-solid fa-phone animate-pulse"></i>
          <span>Đặt Xe: 0935.37.3577</span>
        </a>
        
        <!-- Hotline Icon (Mobile) -->
        <a href="tel:0935373577" class="md:hidden flex size-10 items-center justify-center bg-brand-gradient text-white rounded-full shadow-premium hover:scale-105 transition-transform" aria-label="Gọi hotline">
          <i class="fa-solid fa-phone text-sm"></i>
        </a>
      </div>

    </div>
  </div>
</header>

<!-- Mobile Drawer Overlay — đặt ngoài <header> để tránh bị kẹt stacking context của backdrop-blur -->
<div id="drawer-overlay" class="fixed inset-0 z-[200] bg-slate-900/60 opacity-0 pointer-events-none transition-opacity duration-300 xl:hidden"></div>

<!-- Mobile Drawer Menu -->
<div id="drawer-menu" class="fixed inset-y-0 left-0 z-[210] w-[86vw] max-w-[22rem] bg-white p-5 sm:p-6 shadow-2xl -translate-x-full transition-transform duration-300 ease-in-out xl:hidden">
  <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
    <img src="/uploads/logo.png" alt="Xe du lịch Gia Huy" class="h-6 w-auto object-contain" />
    <button id="drawer-close-btn" class="size-11 flex items-center justify-center text-slate-500 hover:text-brand transition-colors rounded-xl hover:bg-slate-50" aria-label="Đóng menu">
      <i class="fa-solid fa-xmark text-xl"></i>
    </button>
  </div>
  
  <nav class="flex flex-col gap-3">
    {navItems.map(item => {
      const isActive = pathname === item.path;
      return (
        <a 
          href={item.path} 
          class={`flex items-center gap-3 rounded-2xl px-4 py-3.5 text-lg font-extrabold transition-all duration-300 ${
            isActive 
              ? 'text-brand bg-brand/5 shadow-[inset_0_0_0_1px_rgba(20,87,255,0.1)]' 
              : 'text-slate-600 hover:text-brand hover:bg-slate-50'
          }`}
        >
          <span class={`grid size-11 shrink-0 place-items-center rounded-xl transition-colors ${
            isActive ? 'bg-brand text-white' : 'bg-slate-100 text-brand'
          }`}>
            <i class={`fa-solid ${item.icon} text-base`}></i>
          </span>
          <span>{item.label}</span>
        </a>
      );
    })}
  </nav>
  
  <div class="mt-8 pt-6 border-t border-slate-100">
    <a href="tel:0935373577" class="flex items-center justify-center gap-2 w-full bg-brand-gradient text-white text-base font-bold py-3 rounded-xl shadow-premium">
      <i class="fa-solid fa-phone"></i>
      <span>Gọi đặt xe ngay</span>
    </a>
  </div>
</div>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const drawerCloseBtn = document.getElementById('drawer-close-btn');
  const drawerOverlay = document.getElementById('drawer-overlay');
  const drawerMenu = document.getElementById('drawer-menu');
  const mainHeader = document.getElementById('main-header');

  function openDrawer() {
    drawerOverlay?.classList.remove('pointer-events-none', 'opacity-0');
    drawerOverlay?.classList.add('opacity-100');
    drawerMenu?.classList.remove('-translate-x-full');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawerOverlay?.classList.remove('opacity-100');
    drawerOverlay?.classList.add('pointer-events-none', 'opacity-0');
    drawerMenu?.classList.add('-translate-x-full');
    document.body.style.overflow = '';
  }

  mobileMenuBtn?.addEventListener('click', openDrawer);
  drawerCloseBtn?.addEventListener('click', closeDrawer);
  drawerOverlay?.addEventListener('click', closeDrawer);
  drawerMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeDrawer);
  });
  window.addEventListener('keydown', event => {
    if (event.key === 'Escape') closeDrawer();
  });

  // Shrink header on scroll
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      mainHeader?.classList.remove('h-16', 'md:h-20', 'bg-white/85');
      mainHeader?.classList.add('bg-white/95', 'py-1', 'shadow-lg');
    } else {
      mainHeader?.classList.add('h-16', 'md:h-20', 'bg-white/85');
      mainHeader?.classList.remove('bg-white/95', 'py-1', 'shadow-lg');
    }
  });
</script>
