---
const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { label: "Trang chủ", path: "/", id: "top", icon: "fa-house" },
  {
    label: "Giới thiệu",
    path: "/about/",
    id: "gioi-thieu",
    icon: "fa-circle-info",
  },
  {
    label: "Dịch vụ",
    path: "/news/dich-vu/",
    id: "car-rates",
    icon: "fa-car-side",
  },
  {
    label: "Du lịch",
    path: "/news/du-lich/",
    id: "du-lich",
    icon: "fa-compass",
  },
  { label: "Tin tức", path: "/news/tin-tuc/", id: "tin-tuc", icon: "fa-newspaper" },
];
---

<header
  id="main-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300 bg-brand/90 border-b border-white/10 backdrop-blur-md shadow-premium"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative">
    <div class="flex h-16 md:h-20 items-center justify-between gap-4">
      <!-- Hamburger Menu Button (Mobile - Left) -->
      <button
        id="mobile-menu-btn"
        class="xl:hidden size-11 flex items-center justify-center text-white hover:bg-white/10 transition-colors rounded-xl z-10"
        aria-label="Mở menu"
      >
        <i class="fa-solid fa-bars text-xl"></i>
      </button>

      <!-- Logo Centered on Mobile, Left on Desktop -->
      <a
        href="/"
        class="flex shrink-0 items-center gap-2 sm:gap-2.5 absolute left-1/2 -translate-x-1/2 xl:static xl:translate-x-0 transition-all duration-300 hover:scale-105"
      >
        <div class="bg-white px-2 sm:px-2.5 py-1 sm:py-1.5 rounded-xl shadow-sm border border-white/10 flex items-center justify-center">
          <img
            src="/uploads/logo.png"
            alt="Xe du lịch Gia Huy"
            class="h-7 sm:h-8 md:h-10 w-auto object-contain rounded-md"
          />
        </div>
        <div class="hidden sm:flex items-center gap-1.5 leading-none font-black uppercase text-[13px] md:text-[14px] lg:text-[15px] xl:text-base whitespace-nowrap tracking-wider">
          <span class="text-white">Xe Du Lịch</span>
          <span class="text-brand-yellow">Gia Huy</span>
        </div>
      </a>

      <!-- Nav Middle (Desktop) -->
      <nav class="hidden xl:flex items-center gap-1 xl:gap-1.5 mx-auto">
        {
          navItems.map((item) => {
            const isActive = pathname === item.path || (item.path !== '/' && pathname.startsWith(item.path));
            return (
              <a
                href={item.path}
                data-nav-link={item.id}
                class={`inline-flex items-center gap-1.5 xl:gap-2 rounded-xl px-2.5 xl:px-3.5 py-2 text-[15px] xl:text-base font-bold transition-all duration-300 whitespace-nowrap ${
                  isActive
                    ? "text-white bg-white/20 shadow-[inset_0_0_0_1px_rgba(255,255,255,0.25)]"
                    : "text-white/85 hover:text-white hover:bg-white/10"
                }`}
              >
                <span
                  class={`grid size-7 xl:size-8 place-items-center rounded-lg transition-colors ${
                    isActive ? "bg-white text-brand" : "bg-white/10 text-white"
                  }`}
                >
                  <i class={`fa-solid ${item.icon} text-xs xl:text-sm`} />
                </span>
                <span>{item.label}</span>
              </a>
            );
          })
        }
      </nav>

      <!-- Actions Right (Desktop & Mobile) -->
      <div class="flex items-center gap-3 z-10">
        <!-- Hotline CTA (Desktop) -->
        <a
          href="/contact/"
          class="hidden md:inline-flex items-center gap-2 bg-white text-brand hover:bg-brand-yellow hover:text-white text-sm font-bold px-5 py-2.5 rounded-xl border border-white hover:border-brand-yellow transition-all duration-300 shadow-md whitespace-nowrap"
        >
          <i class="fa-solid fa-phone animate-pulse"></i>
          <span>Liên hệ đặt xe</span>
        </a>

        <!-- Hotline Icon (Mobile) -->
        <a
          href="tel:0935373577"
          class="md:hidden flex size-10 items-center justify-center bg-white text-brand rounded-full shadow-premium hover:scale-105 transition-transform"
          aria-label="Gọi hotline"
        >
          <i class="fa-solid fa-phone text-sm"></i>
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Drawer Overlay — đặt ngoài <header> để tránh bị kẹt stacking context của backdrop-blur -->
<div
  id="drawer-overlay"
  class="fixed inset-0 z-[200] bg-slate-900/60 opacity-0 pointer-events-none transition-opacity duration-300 xl:hidden"
>
</div>

<!-- Mobile Drawer Menu -->
<div
  id="drawer-menu"
  class="fixed inset-y-0 left-0 z-[210] w-[86vw] max-w-[22rem] bg-white p-5 sm:p-6 shadow-2xl -translate-x-full transition-transform duration-300 ease-in-out xl:hidden"
>
  <div
    class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6"
  >
    <a href="/" class="flex items-center gap-2 sm:gap-2.5">
      <div class="bg-slate-50 px-2 py-1 rounded-xl border border-slate-200/60 flex items-center justify-center">
        <img
          src="/uploads/logo.png"
          alt="Xe du lịch Gia Huy"
          class="h-8 w-auto object-contain rounded-md"
        />
      </div>
      <div class="flex items-center gap-1 leading-none font-black uppercase text-sm whitespace-nowrap tracking-wider">
        <span class="text-slate-900">Xe Du Lịch</span>
        <span class="text-brand">Gia Huy</span>
      </div>
    </a>
    <button
      id="drawer-close-btn"
      class="size-11 flex items-center justify-center text-slate-500 hover:text-brand transition-colors rounded-xl hover:bg-slate-50"
      aria-label="Đóng menu"
    >
      <i class="fa-solid fa-xmark text-xl"></i>
    </button>
  </div>

  <nav class="flex flex-col gap-3">
    {
      navItems.map((item) => {
        const isActive = pathname === item.path || (item.path !== '/' && pathname.startsWith(item.path));
        return (
          <a
            href={item.path}
            data-nav-link={item.id}
            class={`flex items-center gap-3 rounded-2xl px-3 py-3 text-base font-semibold transition-all duration-300 ${
              isActive
                ? "text-brand bg-brand/5 shadow-[inset_0_0_0_1px_rgba(20,87,255,0.1)]"
                : "text-slate-600 hover:text-brand hover:bg-slate-50"
            }`}
          >
            <span
              class={`grid size-10 shrink-0 place-items-center rounded-xl transition-colors ${
                isActive ? "bg-brand text-white" : "bg-slate-100 text-brand"
              }`}
            >
              <i class={`fa-solid ${item.icon} text-base`} />
            </span>
            <span>{item.label}</span>
          </a>
        );
      })
    }
  </nav>

  <div class="mt-8 pt-6 border-t border-slate-100">
    <a
      href="/contact/"
      class="flex items-center justify-center gap-2 w-full bg-brand-gradient text-white text-base font-bold py-3 rounded-xl shadow-premium"
    >
      <i class="fa-solid fa-phone"></i>
      <span>Liên hệ đặt xe ngay</span>
    </a>
  </div>
</div>

<script>
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const drawerCloseBtn = document.getElementById("drawer-close-btn");
  const drawerOverlay = document.getElementById("drawer-overlay");
  const drawerMenu = document.getElementById("drawer-menu");
  const mainHeader = document.getElementById("main-header");

  function openDrawer() {
    drawerOverlay?.classList.remove("pointer-events-none", "opacity-0");
    drawerOverlay?.classList.add("opacity-100");
    drawerMenu?.classList.remove("-translate-x-full");
    document.body.style.overflow = "hidden";
  }

  function closeDrawer() {
    drawerOverlay?.classList.remove("opacity-100");
    drawerOverlay?.classList.add("pointer-events-none", "opacity-0");
    drawerMenu?.classList.add("-translate-x-full");
    document.body.style.overflow = "";
  }

  mobileMenuBtn?.addEventListener("click", openDrawer);
  drawerCloseBtn?.addEventListener("click", closeDrawer);
  drawerOverlay?.addEventListener("click", closeDrawer);
  drawerMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeDrawer);
  });
  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeDrawer();
  });

  // Shrink header on scroll
  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      mainHeader?.classList.remove("h-16", "md:h-20", "bg-brand/90");
      mainHeader?.classList.add("bg-brand/95", "py-1", "shadow-lg");
    } else {
      mainHeader?.classList.add("h-16", "md:h-20", "bg-brand/90");
      mainHeader?.classList.remove("bg-brand/95", "py-1", "shadow-lg");
    }
  });
</script>
