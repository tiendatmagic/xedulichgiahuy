---
import Layout from '../layouts/Layout.astro';
import postsData from '../data/posts.json';

// Get featured tours (du-lich)
const featuredTours = postsData.filter(post => post.category === 'du-lich').slice(0, 4);

// Car category data mapping to downloaded photos
const carTabs = [
  {
    id: 'xe-nha-trang-1',
    label: 'Xe Nha Trang',
    cars: [
      { image: '/uploads/photos/thumbs/photos_300x300-74-4a2d2dae466973e57dbd89fb8782337b.jpg' },
      { image: '/uploads/photos/thumbs/photos_300x300-73-e1e92381f8cdf6119286b6d42b6ac219.jpg' },
      { image: '/uploads/photos/thumbs/photos_300x300-72-547957875627f93d2defe0f29fd1d75b.jpg' },
      { image: '/uploads/photos/thumbs/photos_300x300-76-48f31ebac6c5629598da39fa60f0b88d.jpg' },
    ]
  },
  {
    id: 'xe-nha-trang-2',
    label: 'Xe Nha Trang',
    cars: [
      { image: '/uploads/photos/thumbs/photos_300x300-69-516f356e5f7d20204ce31537aa78b16f.jpg' },
      { image: '/uploads/photos/thumbs/photos_300x300-68-94a6d63335e5128afcce23f1ee912d51.jpg' },
      { image: '/uploads/photos/thumbs/photos_300x300-67-4cd485dd3603caa984c7c9206f0fe909.jpg' },
      { image: '/uploads/photos/thumbs/photos_300x300-66-9b3a10d7e66356e574e7a38ba00918d8.jpg' }
    ]
  },
  {
    id: 'xe-gia-huy-1',
    label: 'Xe Gia Huy',
    cars: [
      { image: '/uploads/photos/thumbs/photos_300x300-43-456c4b99e0c2a163588362ec5e8bb37c.jpg' },
      { image: '/uploads/photos/thumbs/photos_300x300-44-f30da1a7c0bb3ea16269264144efb6b1.jpg' },
      { image: '/uploads/photos/thumbs/photos_300x300-48-e541980b9be87bde52720294c545811a.jpg' },
      { image: '/uploads/photos/thumbs/photos_300x300-47-d975a13d13fbf69e21189496edc25480.jpg' }
    ]
  },
  {
    id: 'xe-gia-huy-2',
    label: 'Xe Gia Huy',
    cars: [
      { image: '/uploads/photos/thumbs/photos_300x300-41-59949b56fdd3825730bcd9099ec301c4.jpg' },
      { image: '/uploads/photos/thumbs/photos_300x300-34-472658c83315e469342b0c760488a6ba.jpg' },
      { image: '/uploads/photos/thumbs/photos_300x300-35-1628f348053aacb9bfbaa88a58b35ce5.jpg' },
      { image: '/uploads/photos/thumbs/photos_300x300-36-6fa546343b2342e4f5f4eceb700e8b56.jpg' },
    ]
  }
];

const partners = [
  { name: 'Việt Travel', logo: '/uploads/slider/vietravel.png' },
  { name: 'Kiều Gia Media', logo: '/uploads/slider/kieugiamedia.jpg', url: 'https://kieugiamedia.com' },
  { name: 'Kiều Gia Travel', logo: '/uploads/slider/kieugiatravel.jpg', url: 'https://kieugiatravel.com' },
  { name: 'Kiều Gia Land', logo: '/uploads/slider/kieugiatland.jpg', url: 'https://kieugialand.com' },
  { name: 'Vinpearl Villas', logo: '/uploads/slider/golfland.vinpearlvillas.com_.png' }
];

const sliderImages = [
  '/uploads/slider/xe-du-lich-nha-trang_5.jpg',
  '/uploads/slider/xe-du-lich-nha-trang.jpg',
  '/uploads/slider/xe-du-lich-nha-trang_2.jpg',
  '/uploads/slider/xe-du-lich-nha-trang_3.jpg',
  '/uploads/slider/xe-du-lich-nha-trang_1.jpg'
];
---

<Layout
  title="Cho thuê xe du lịch Nha Trang - Nhà Xe Gia Huy Báo giá mới nhất"
  description="Dịch vụ cho thuê xe du lịch Nha Trang từ 4-45 chỗ đời mới, giá rẻ. Đưa đón sân bay Cam Ranh và đi tour du lịch liên tỉnh. Hotline 24/7: 0935.37.3577 uy tín."
  keywords="xe du lịch nha trang, thuê xe du lịch nha trang, cho thuê xe nha trang, thuê xe gia huy, thuê xe nha trang giá rẻ, thuê xe 4-45 chỗ nha trang"
>
  <!-- Hero Slideshow Section -->
  <!-- Banner slider: keep the artwork ratio so text stays visible on every viewport -->
  <section id="top" class="relative w-full overflow-hidden bg-slate-900 scroll-mt-24">
    <div class="group relative w-full aspect-[1920/600] min-h-[132px] max-h-[620px]">
      <div id="hero-slider" class="flex h-full w-full snap-x snap-mandatory overflow-x-auto overscroll-x-contain scroll-smooth touch-pan-x no-scrollbar">
        {sliderImages.map((src, index) => (
          <div class="relative h-full w-full flex-none snap-center">
            <img
              src={src}
              alt={`Banner xe du lịch Gia Huy ${index + 1}`}
              class="h-full w-full object-fill"
              loading={index === 0 ? 'eager' : 'lazy'}
              draggable="false"
            />
          </div>
        ))}
      </div>

      <button
        type="button"
        aria-label="Ảnh trước"
        data-hero-arrow="prev"
        class="absolute left-2 sm:left-5 top-1/2 z-30 grid size-9 sm:size-11 -translate-y-1/2 place-items-center rounded-full border border-white/40 bg-slate-950/35 text-white opacity-100 shadow-lg backdrop-blur-md transition-all duration-300 hover:bg-brand md:opacity-0 md:group-hover:opacity-100"
      >
        <i class="fa-solid fa-chevron-left text-sm"></i>
      </button>
      <button
        type="button"
        aria-label="Ảnh sau"
        data-hero-arrow="next"
        class="absolute right-2 sm:right-5 top-1/2 z-30 grid size-9 sm:size-11 -translate-y-1/2 place-items-center rounded-full border border-white/40 bg-slate-950/35 text-white opacity-100 shadow-lg backdrop-blur-md transition-all duration-300 hover:bg-brand md:opacity-0 md:group-hover:opacity-100"
      >
        <i class="fa-solid fa-chevron-right text-sm"></i>
      </button>

      <!-- Slide Indicators -->
      <div class="absolute bottom-2.5 sm:bottom-4 left-0 right-0 z-20 flex justify-center gap-2">
        {sliderImages.map((_, index) => (
          <button
            class={`size-2.5 rounded-full border border-white/40 transition-all duration-300 ${index === 0 ? 'bg-white w-6' : 'bg-white/40'}`}
            data-slide={index}
          ></button>
        ))}
      </div>
    </div>
  </section>

  <!-- Quick Intro & Banner -->
  <section id="gioi-thieu" class="py-16 md:py-24 bg-white relative overflow-hidden scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Text col - 6 cols -->
        <div class="lg:col-span-6">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-brand/20 bg-brand/5 px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-brand">
            <i class="fa-solid fa-circle-info"></i> Giới thiệu nhà xe
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mt-3 mb-6">
            Xe Du Lịch Gia Huy Nha Trang
          </h2>
          <div class="text-slate-600 text-sm md:text-base leading-relaxed space-y-4">
            <p>
              Nhà xe Gia Huy chuyên cho thuê xe ôtô từ 4, 7, 16, 29, 35 đến 45 chỗ đời mới, phục vụ tất cả các nhu cầu di chuyển của quý khách tại thành phố biển Nha Trang, tỉnh Khánh Hòa và các tỉnh miền Trung, Tây Nguyên.
            </p>
            <p class="font-semibold text-brand">
              Cam kết mang đến dịch vụ tốt nhất cùng mức giá thuê xe cạnh tranh, hấp dẫn nhất thị trường!
            </p>
            <p>
              Đội ngũ lái xe của Gia Huy đều là những tài xế có nhiều năm kinh nghiệm chạy xe du lịch đường dài, thái độ phục vụ ân cần, nhiệt tình và chu đáo, bảo đảm quý khách sẽ có một chuyến đi an toàn, thoải mái nhất.
            </p>
          </div>
          <div class="mt-8 flex flex-wrap gap-4 items-center">
            <div class="bg-slate-50 border border-slate-200/60 rounded-2xl px-5 py-3 shadow-sm">
              <p class="text-xs text-slate-400">Đặt xe nhanh (Hotline 24/7)</p>
              <a href="tel:0935373577" class="text-xl font-bold text-brand hover:underline">0935.37.3577</a>
            </div>
            <div class="bg-slate-50 border border-slate-200/60 rounded-2xl px-5 py-3 shadow-sm">
              <p class="text-xs text-slate-400">Địa chỉ văn phòng</p>
              <p class="text-sm font-semibold text-slate-800">Vĩnh Lương, Nha Trang, Khánh Hòa</p>
            </div>
          </div>
        </div>

        <!-- Banner image col - 6 cols -->
        <div class="lg:col-span-6 relative">
          <!-- Colorful backdrop decoration -->
          <div class="absolute -inset-4 bg-brand-gradient opacity-10 blur-2xl rounded-3xl -z-10"></div>
          <div class="rounded-3xl border border-slate-200/60 overflow-hidden shadow-premium group">
            <img
              src="/uploads/banners/xe-du-lich-nha-trang.jpg"
              alt="Dịch vụ xe du lịch Nha Trang Gia Huy"
              class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Strengths Section -->
  <section id="cam-ket" class="py-16 md:py-24 bg-[#f1f8ff] relative scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">

      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-brand/20 bg-brand/5 px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-brand">
          <i class="fa-solid fa-star text-brand-yellow animate-spin [animation-duration:6s]"></i> Tại sao nên chọn chúng tôi
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight mt-3 mb-4">Cam Kết Chất Lượng Vượt Trội</h2>
        <p class="text-slate-500 text-sm sm:text-base leading-relaxed">
          Chúng tôi xây dựng uy tín dựa trên sự hài lòng và trải nghiệm di chuyển an toàn của mọi khách hàng.
        </p>
      </div>

      <!-- Desktop: grid 3 cột | Mobile: slider có swipe + bullets -->
      <div class="group relative -mx-4 px-4 md:mx-0 md:px-0">
        <div id="strengths-slider" class="flex md:grid md:grid-cols-3 gap-6 overflow-x-auto md:overflow-visible snap-x snap-mandatory scroll-smooth touch-pan-x no-scrollbar py-4 md:pb-0">

          <!-- Card 1 -->
          <div class="glass rounded-3xl border border-slate-200/60 p-4 sm:p-6 shadow-premium hover:shadow-glow transition-all duration-300 hover:-translate-y-1 group relative flex-none w-[85vw] sm:w-[70vw] md:w-auto snap-center overflow-hidden">
            <div class="absolute top-0 right-0 h-24 w-24 rounded-bl-full bg-brand/5 transition-transform duration-500 group-hover:scale-150 -z-10"></div>
            <span class="grid size-12 place-items-center rounded-2xl bg-brand-gradient text-white shadow-glow mb-6 text-xl">
              <i class="fa-solid fa-bolt"></i>
            </span>
            <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-3">Nhanh chóng</h3>
            <p class="text-sm md:text-base text-slate-500 mb-5 leading-relaxed">
              Tiếp nhận yêu cầu qua điện thoại, zalo, website nhanh chóng. Tiến hành báo giá tối ưu và tư vấn lộ trình phù hợp ngay sau vài phút.
            </p>
            <ul class="space-y-2 text-sm md:text-base text-slate-600 font-medium border-t border-slate-100 pt-4">
              <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-brand-green"></i> Tiếp nhận yêu cầu siêu tốc</li>
              <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-brand-green"></i> Tư vấn hỗ trợ miễn phí 24/7</li>
              <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-brand-green"></i> Phục vụ đón tiễn tận nơi</li>
            </ul>
          </div>

          <!-- Card 2 -->
          <div class="glass rounded-3xl border border-slate-200/60 p-4 sm:p-6 shadow-premium hover:shadow-glow transition-all duration-300 hover:-translate-y-1 group relative flex-none w-[85vw] sm:w-[70vw] md:w-auto snap-center overflow-hidden">
            <div class="absolute top-0 right-0 h-24 w-24 rounded-bl-full bg-brand-cyan/5 transition-transform duration-500 group-hover:scale-150 -z-10"></div>
            <span class="grid size-12 place-items-center rounded-2xl bg-cyan-500 text-white shadow-lg mb-6 text-xl">
              <i class="fa-solid fa-award"></i>
            </span>
            <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-3">Kinh nghiệm</h3>
            <p class="text-sm md:text-base text-slate-500 mb-5 leading-relaxed">
              Hơn 10 năm hoạt động trong ngành vận tải du lịch tại Nha Trang, sở hữu dàn xe đời mới và đội ngũ tài xế chuyên chạy đường dài đèo dốc an toàn.
            </p>
            <ul class="space-y-2 text-sm md:text-base text-slate-600 font-medium border-t border-slate-100 pt-4">
              <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-brand-green"></i> Hệ thống xe đời mới chất lượng</li>
              <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-brand-green"></i> Tài xế lịch sự, rành đường</li>
              <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-brand-green"></i> Phục vụ chu đáo chuyên nghiệp</li>
            </ul>
          </div>

          <!-- Card 3 -->
          <div class="glass rounded-3xl border border-slate-200/60 p-4 sm:p-6 shadow-premium hover:shadow-glow transition-all duration-300 hover:-translate-y-1 group relative flex-none w-[85vw] sm:w-[70vw] md:w-auto snap-center overflow-hidden">
            <div class="absolute top-0 right-0 h-24 w-24 rounded-bl-full bg-brand-green/5 transition-transform duration-500 group-hover:scale-150 -z-10"></div>
            <span class="grid size-12 place-items-center rounded-2xl bg-emerald-500 text-white shadow-lg mb-6 text-xl">
              <i class="fa-solid fa-shield-halved"></i>
            </span>
            <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-3">Chuyên nghiệp</h3>
            <p class="text-sm md:text-base text-slate-500 mb-5 leading-relaxed">
              Luôn tuân thủ lịch trình và thời gian của khách hàng, đảm bảo an toàn giao thông và ứng biến xử lý mọi vấn đề linh hoạt.
            </p>
            <ul class="space-y-2 text-sm md:text-base text-slate-600 font-medium border-t border-slate-100 pt-4">
              <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-brand-green"></i> Đón tiễn đúng giờ quy định</li>
              <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-brand-green"></i> Xử lý linh hoạt mọi sự cố</li>
              <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-brand-green"></i> Cam kết hoàn lại tiền nếu sai hẹn</li>
            </ul>
          </div>

        </div>

        <button
          type="button"
          aria-label="Lướt sang trái"
          data-slider-prev="strengths-slider"
          class="absolute left-2 top-1/2 z-20 grid size-10 -translate-y-1/2 place-items-center rounded-full border border-slate-200 bg-white/90 text-slate-700 opacity-100 shadow-premium backdrop-blur transition-all duration-300 hover:bg-brand hover:text-white disabled:pointer-events-none disabled:opacity-0 md:hidden"
        >
          <i class="fa-solid fa-chevron-left text-sm"></i>
        </button>
        <button
          type="button"
          aria-label="Lướt sang phải"
          data-slider-next="strengths-slider"
          class="absolute right-2 top-1/2 z-20 grid size-10 -translate-y-1/2 place-items-center rounded-full border border-slate-200 bg-white/90 text-slate-700 opacity-100 shadow-premium backdrop-blur transition-all duration-300 hover:bg-brand hover:text-white disabled:pointer-events-none disabled:opacity-0 md:hidden"
        >
          <i class="fa-solid fa-chevron-right text-sm"></i>
        </button>

        <!-- Bullet dots cho mobile slider -->
        <div id="strengths-dots" class="flex md:hidden justify-center gap-2 mt-6">
          <button class="size-2.5 rounded-full bg-brand transition-all duration-300 w-6" data-strengths-dot="0"></button>
          <button class="size-2.5 rounded-full bg-slate-300 transition-all duration-300" data-strengths-dot="1"></button>
          <button class="size-2.5 rounded-full bg-slate-300 transition-all duration-300" data-strengths-dot="2"></button>
        </div>
      </div>

    </div>
  </section>

  <!-- Car Category Tabs Rates Section -->
  <section id="car-rates" class="py-16 md:py-24 bg-white relative overflow-hidden scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">

      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-brand/20 bg-brand/5 px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-brand">
          <i class="fa-solid fa-car"></i> Danh mục xe du lịch
        </span>
        <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight mt-3 mb-4">Dàn Xe Đời Mới Cao Cấp</h2>
        <p class="text-slate-500 text-sm md:text-base leading-relaxed">
          Đầy đủ chủng loại xe phục vụ khách từ cá nhân đến tập thể cơ quan lớn.
        </p>
      </div>

      <!-- Tab Buttons Switcher -->
      <div class="flex justify-center mb-10">
        <div class="inline-flex p-1 bg-slate-100 rounded-2xl border border-slate-200/50 flex-wrap justify-center gap-1">
          {carTabs.map((tab, idx) => (
            <button
              class={`px-5 py-2.5 rounded-xl text-sm font-bold transition-all duration-300 ${idx === 0 ? 'bg-brand text-white shadow-premium' : 'text-slate-600 hover:text-brand'}`}
              data-tab-trigger={tab.id}
            >
              {tab.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Tab Content Panels -->
      <div class="w-full">
        {carTabs.map((tab, idx) => (
          <div
            id={tab.id}
            class={`grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3 sm:gap-5 lg:gap-6 ${idx === 0 ? '' : 'hidden'}`}
          >

            {tab.cars.map(car => (
              <button
                type="button"
                class="group relative overflow-hidden rounded-2xl sm:rounded-3xl aspect-[4/3] bg-slate-100 border border-slate-200/60 shadow-sm hover:shadow-premium transition-all duration-500 cursor-zoom-in focus:outline-none"
                data-lightbox-trigger={car.image}
                aria-label="Xem ảnh xe lớn"
              >
                <img
                  src={car.image}
                  alt={`Dàn xe du lịch Gia Huy Nha Trang ${tab.label}`}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  loading="lazy"
                />
                <!-- Hover Overlay -->
                <div class="absolute inset-0 bg-slate-950/0 group-hover:bg-slate-950/45 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-all duration-500 z-10">
                  <span class="size-11 sm:size-12 rounded-full bg-white/20 text-white flex items-center justify-center border border-white/30 backdrop-blur-md transform scale-50 group-hover:scale-100 transition-all duration-500 shadow-lg text-lg">
                    <i class="fa-solid fa-magnifying-glass-plus"></i>
                  </span>
                </div>
                <!-- Category Badge overlay -->
                <span class="absolute bottom-3 left-3 bg-black/45 border border-white/10 backdrop-blur-md text-white text-[9px] sm:text-[10px] font-bold px-2 py-0.5 rounded-full pointer-events-none z-10">
                  {tab.label}
                </span>
              </button>
            ))}
          </div>
        ))}
      </div>

      <!-- Xem tất cả Button -->
      <!-- <div class="flex justify-center mt-12">
        <a
          href="/news/dich-vu/"
          class="inline-flex items-center justify-center bg-brand hover:bg-brand-yellow hover:scale-105 text-white font-bold px-8 py-3.5 rounded-xl shadow-premium hover:shadow-glow transition-all duration-300 text-base"
        >
          XEM TẤT CẢ
        </a>
      </div> -->



    </div>
  </section>

  <!-- Featured Tours / Destination (Du lịch Nha Trang) -->
  <section id="tin-tuc" class="py-16 md:py-24 bg-[#f1f8ff] relative overflow-hidden scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">

      <div class="flex flex-col md:flex-row items-center justify-between gap-6 mb-12">
        <div class="block mx-auto text-center md:mx-0 md:text-left">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-brand/20 bg-brand/5 px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-brand">
            <i class="fa-solid fa-compass"></i> Địa điểm du lịch nổi tiếng
          </span>
          <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight mt-3">Tour Du Lịch Nha Trang</h2>
        </div>
        <a href="/news/tin-tuc/" class="inline-flex items-center gap-1 text-sm font-bold text-brand hover:underline">
          Xem tất cả bài viết <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5 lg:gap-6">
        {featuredTours.map(tour => (
          <article class="bg-white border border-slate-200/60 rounded-2xl sm:rounded-3xl overflow-hidden shadow-sm hover:shadow-premium transition-all duration-300 group flex flex-col justify-between">
            <a href={`/news/${tour.category}/${tour.slug}/`} class="block overflow-hidden aspect-[16/10] bg-slate-100 border-b border-slate-100">
              <img
                src={tour.image}
                alt={tour.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </a>
            <div class="p-3 sm:p-5 flex-grow flex flex-col justify-between">
              <div>
                <span class="text-[9px] sm:text-[10px] font-bold text-brand uppercase tracking-wider">Đón Tiễn Tour</span>
                <h3 class="text-sm sm:text-[15px] font-extrabold text-slate-950 mt-1 line-clamp-2 hover:text-brand transition-colors leading-snug">
                  <a href={`/news/${tour.category}/${tour.slug}/`}>{tour.title}</a>
                </h3>
                <p class="text-[11px] sm:text-xs text-slate-500 mt-1.5 sm:mt-2 line-clamp-2 leading-snug sm:leading-relaxed">
                  {tour.description}
                </p>
              </div>
              <div class="mt-3 sm:mt-5 pt-2 sm:pt-3 border-t border-slate-100 flex items-center justify-between gap-2 text-[10px] sm:text-[11px] text-slate-400">
                <span><i class="fa-regular fa-clock mr-1"></i> {tour.date.split(' ')[0]}</span>
                <span><i class="fa-regular fa-eye mr-1"></i> {tour.views}</span>
              </div>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- Partner Section -->
  <section class="py-12 bg-white border-y border-slate-100 overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <!-- Tiêu đề đồng bộ với các section khác -->
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-brand/20 bg-brand/5 px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-brand">
          <i class="fa-solid fa-handshake"></i> Hợp tác &amp; tin dùng
        </span>
        <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight mt-3">Đối Tác &amp; Khách Hàng Tin Dùng</h2>
      </div>

      <!-- Slider đa cột: desktop 5, tablet 4, mobile sm 3, mobile xs 2 -->
      <div class="group relative -mx-4 sm:-mx-6 lg:-mx-8">
        <div
          id="partners-slider"
          class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth touch-pan-x no-scrollbar gap-0"
        >
          {partners.map((p, i) => (
            <div
              class="flex-none snap-center w-1/2 sm:w-1/3 md:w-1/4 lg:w-1/5 px-4 py-6 flex items-center justify-center"
              data-partner-item={i}
            >
              {p.url ? (
                <a href={p.url} target="_blank" rel="noopener noreferrer" title={p.name}
                  class="w-full flex items-center justify-center hover:scale-105 transition-transform duration-200">
                  <img src={p.logo} alt={p.name} class="w-full h-auto max-h-20 object-contain" />
                </a>
              ) : (
                <img src={p.logo} alt={p.name} title={p.name}
                  class="w-full h-auto max-h-20 object-contain hover:scale-105 transition-transform duration-200" />
              )}
            </div>
          ))}
        </div>

        <button
          type="button"
          aria-label="Lướt đối tác sang trái"
          data-slider-prev="partners-slider"
          class="absolute left-2 sm:left-4 top-1/2 z-20 grid size-10 -translate-y-1/2 place-items-center rounded-full border border-slate-200 bg-white/90 text-slate-700 opacity-100 shadow-premium backdrop-blur transition-all duration-300 hover:bg-brand hover:text-white disabled:pointer-events-none disabled:opacity-0 md:opacity-0 md:group-hover:opacity-100"
        >
          <i class="fa-solid fa-chevron-left text-sm"></i>
        </button>
        <button
          type="button"
          aria-label="Lướt đối tác sang phải"
          data-slider-next="partners-slider"
          class="absolute right-2 sm:right-4 top-1/2 z-20 grid size-10 -translate-y-1/2 place-items-center rounded-full border border-slate-200 bg-white/90 text-slate-700 opacity-100 shadow-premium backdrop-blur transition-all duration-300 hover:bg-brand hover:text-white disabled:pointer-events-none disabled:opacity-0 md:opacity-0 md:group-hover:opacity-100"
        >
          <i class="fa-solid fa-chevron-right text-sm"></i>
        </button>
      </div>

      <!-- Bullet dots -->
      <div id="partners-dots" class="flex justify-center gap-2 mt-6">
        {partners.map((_, i) => (
          <button
            class={`size-2 rounded-full transition-all duration-300 ${i === 0 ? 'bg-brand w-5' : 'bg-slate-300'}`}
            data-partner-dot={i}
          ></button>
        ))}
      </div>

  <!-- Lightbox Modal -->
  <div
    id="lightbox-modal"
    class="fixed inset-0 z-[9999] bg-slate-950/95 opacity-0 pointer-events-none flex items-center justify-center transition-opacity duration-300 p-4 sm:p-6"
    role="dialog"
    aria-modal="true"
    aria-label="Phóng to hình ảnh xe"
  >
    <button
      id="lightbox-close"
      class="absolute top-4 right-4 sm:top-6 sm:right-6 size-12 flex items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/25 transition-all text-2xl border border-white/20 backdrop-blur-md z-[10010] cursor-pointer"
      aria-label="Đóng"
    >
      <i class="fa-solid fa-xmark"></i>
    </button>

    <button
      id="lightbox-prev"
      class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 size-12 flex items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/25 transition-all text-xl border border-white/20 backdrop-blur-md z-[10010] cursor-pointer"
      aria-label="Ảnh trước"
    >
      <i class="fa-solid fa-chevron-left"></i>
    </button>
    <button
      id="lightbox-next"
      class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 size-12 flex items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/25 transition-all text-xl border border-white/20 backdrop-blur-md z-[10010] cursor-pointer"
      aria-label="Ảnh sau"
    >
      <i class="fa-solid fa-chevron-right"></i>
    </button>

    <div class="relative max-w-[92vw] md:max-w-5xl max-h-[85vh] w-full flex items-center justify-center select-none">
      <img
        id="lightbox-img"
        src=""
        alt="Xe du lịch Gia Huy"
        class="w-full max-w-4xl h-auto max-h-[75vh] object-contain rounded-xl sm:rounded-2xl shadow-2xl transition-opacity duration-300"
      />
    </div>
  </div>
</Layout>

<script>
  // ==========================================
  // 1. Hero Slideshow
  // ==========================================
  let currentSlide = 0;
  const heroSlider = document.getElementById('hero-slider') as HTMLElement | null;
  const slides = document.querySelectorAll('#hero-slider > div');
  const slideIndicators = document.querySelectorAll('button[data-slide]');
  const heroArrows = document.querySelectorAll('[data-hero-arrow]');
  const totalSlides = slides.length;

  function updateHeroIndicators(index: number) {
    slideIndicators.forEach((indicator, i) => {
      if (i === index) {
        indicator.classList.add('bg-white', 'w-6');
        indicator.classList.remove('bg-white/40');
      } else {
        indicator.classList.remove('bg-white', 'w-6');
        indicator.classList.add('bg-white/40');
      }
    });
  }

  function setSlide(index: number, shouldScroll = true) {
    if (!totalSlides) return;
    index = (index + totalSlides) % totalSlides;
    currentSlide = index;
    updateHeroIndicators(currentSlide);

    if (shouldScroll && heroSlider) {
      heroSlider.scrollTo({
        left: heroSlider.clientWidth * currentSlide,
        behavior: 'smooth'
      });
    }
  }

  function nextSlide() {
    setSlide((currentSlide + 1) % totalSlides);
  }

  let heroInterval = setInterval(nextSlide, 5000);
  slideIndicators.forEach((ind, i) => {
    ind.addEventListener('click', () => {
      clearInterval(heroInterval);
      setSlide(i);
      heroInterval = setInterval(nextSlide, 5000);
    });
  });
  heroArrows.forEach(btn => {
    btn.addEventListener('click', () => {
      clearInterval(heroInterval);
      const direction = btn.getAttribute('data-hero-arrow') === 'prev' ? -1 : 1;
      setSlide(currentSlide + direction);
      heroInterval = setInterval(nextSlide, 5000);
    });
  });
  if (heroSlider) {
    let isHeroDragging = false;
    let heroDragStartX = 0;
    let heroDragStartScroll = 0;

    heroSlider.addEventListener('scroll', () => {
      const nextIndex = Math.round(heroSlider.scrollLeft / heroSlider.clientWidth);
      if (nextIndex !== currentSlide) {
        setSlide(nextIndex, false);
      }
    }, { passive: true });

    heroSlider.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      clearInterval(heroInterval);
      isHeroDragging = true;
      heroDragStartX = event.clientX;
      heroDragStartScroll = heroSlider.scrollLeft;
      heroSlider.classList.remove('scroll-smooth');
      heroSlider.setPointerCapture(event.pointerId);
    });

    heroSlider.addEventListener('pointermove', (event) => {
      if (!isHeroDragging) return;
      heroSlider.scrollLeft = heroDragStartScroll - (event.clientX - heroDragStartX);
    });

    function finishHeroDrag(event: PointerEvent) {
      if (!isHeroDragging) return;
      isHeroDragging = false;
      heroSlider.classList.add('scroll-smooth');
      const nextIndex = Math.round(heroSlider.scrollLeft / heroSlider.clientWidth);
      setSlide(nextIndex);
      if (heroSlider.hasPointerCapture(event.pointerId)) {
        heroSlider.releasePointerCapture(event.pointerId);
      }
      heroInterval = setInterval(nextSlide, 5000);
    }

    heroSlider.addEventListener('pointerup', finishHeroDrag);
    heroSlider.addEventListener('pointercancel', finishHeroDrag);
    window.addEventListener('resize', () => setSlide(currentSlide, false));
  }

  // ==========================================
  // 2. Tab Switcher (Xe categories)
  // ==========================================
  const tabTriggers = document.querySelectorAll('[data-tab-trigger]');
  tabTriggers.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-tab-trigger');
      tabTriggers.forEach(t => {
        t.classList.remove('bg-brand', 'text-white', 'shadow-premium');
        t.classList.add('text-slate-600', 'hover:text-brand');
      });
      btn.classList.add('bg-brand', 'text-white', 'shadow-premium');
      btn.classList.remove('text-slate-600', 'hover:text-brand');
      ['xe-nha-trang-1', 'xe-nha-trang-2', 'xe-gia-huy-1', 'xe-gia-huy-2'].forEach(id => {
        const panel = document.getElementById(id);
        if (panel) {
          id === targetId ? panel.classList.remove('hidden') : panel.classList.add('hidden');
        }
      });
    });
  });

  // ==========================================
  // 3. Strengths Slider (mobile) — scroll-snap + bullet dots
  // ==========================================
  const strengthsSlider = document.getElementById('strengths-slider');
  const strengthsDots = document.querySelectorAll('[data-strengths-dot]');

  function getSliderItems(slider: HTMLElement) {
    return Array.from(slider.querySelectorAll(':scope > div')) as HTMLElement[];
  }

  function getClosestSliderIndex(slider: HTMLElement, items: HTMLElement[]) {
    let closestIndex = 0;
    let closestDist = Infinity;
    const sliderCenter = slider.scrollLeft + slider.clientWidth / 2;

    items.forEach((item, i) => {
      const itemCenter = item.offsetLeft + item.offsetWidth / 2;
      const dist = Math.abs(itemCenter - sliderCenter);
      if (dist < closestDist) {
        closestDist = dist;
        closestIndex = i;
      }
    });

    return closestIndex;
  }

  function scrollToSliderItem(slider: HTMLElement, index: number) {
    const items = getSliderItems(slider);
    const target = items[Math.max(0, Math.min(index, items.length - 1))];
    if (!target) return;

    const left = target.offsetLeft - (slider.clientWidth - target.offsetWidth) / 2;
    slider.scrollTo({ left, behavior: 'smooth' });
  }

  function updateSliderArrowState(slider: HTMLElement) {
    const maxScroll = slider.scrollWidth - slider.clientWidth;
    const prev = document.querySelector(`[data-slider-prev="${slider.id}"]`) as HTMLButtonElement | null;
    const next = document.querySelector(`[data-slider-next="${slider.id}"]`) as HTMLButtonElement | null;

    if (prev) prev.disabled = slider.scrollLeft <= 2;
    if (next) next.disabled = maxScroll <= 2 || slider.scrollLeft >= maxScroll - 2;
  }

  function bindSliderArrows(slider: HTMLElement) {
    const prev = document.querySelector(`[data-slider-prev="${slider.id}"]`);
    const next = document.querySelector(`[data-slider-next="${slider.id}"]`);

    prev?.addEventListener('click', () => {
      const items = getSliderItems(slider);
      scrollToSliderItem(slider, getClosestSliderIndex(slider, items) - 1);
    });

    next?.addEventListener('click', () => {
      const items = getSliderItems(slider);
      scrollToSliderItem(slider, getClosestSliderIndex(slider, items) + 1);
    });

    updateSliderArrowState(slider);
    window.addEventListener('resize', () => updateSliderArrowState(slider));
  }

  function updateStrengthsDot(index: number) {
    strengthsDots.forEach((dot, i) => {
      if (i === index) {
        dot.classList.add('bg-brand', 'w-6');
        dot.classList.remove('bg-slate-300');
      } else {
        dot.classList.remove('bg-brand', 'w-6');
        dot.classList.add('bg-slate-300');
      }
    });
  }

  if (strengthsSlider) {
    const strengthsEl = strengthsSlider as HTMLElement;
    bindSliderArrows(strengthsEl);

    // Dot click → scroll to card
    strengthsDots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        scrollToSliderItem(strengthsEl, i);
        updateStrengthsDot(i);
      });
    });

    // Scroll → update dot
    strengthsSlider.addEventListener('scroll', () => {
      const cards = getSliderItems(strengthsEl);
      updateStrengthsDot(getClosestSliderIndex(strengthsEl, cards));
      updateSliderArrowState(strengthsEl);
    }, { passive: true });
  }

  // ==========================================
  // 4. Partners Slider — scroll-snap + bullet dots (luôn hiện)
  // ==========================================
  const partnersSlider = document.getElementById('partners-slider');
  const partnerDots = document.querySelectorAll('[data-partner-dot]');

  function updatePartnerDot(index: number) {
    partnerDots.forEach((dot, i) => {
      if (i === index) {
        dot.classList.add('bg-brand', 'w-5');
        dot.classList.remove('bg-slate-300');
      } else {
        dot.classList.remove('bg-brand', 'w-5');
        dot.classList.add('bg-slate-300');
      }
    });
  }

  if (partnersSlider) {
    const partnersEl = partnersSlider as HTMLElement;
    bindSliderArrows(partnersEl);

    // Dot click → scroll to item
    partnerDots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        scrollToSliderItem(partnersEl, i);
        updatePartnerDot(i);
      });
    });

    // Scroll → update dot
    partnersSlider.addEventListener('scroll', () => {
      const items = getSliderItems(partnersEl);
      updatePartnerDot(getClosestSliderIndex(partnersEl, items));
      updateSliderArrowState(partnersEl);
    }, { passive: true });
  }

  // ==========================================
  // 5. Lightbox Modal
  // ==========================================
  const lightboxModal = document.getElementById('lightbox-modal');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxPrev = document.getElementById('lightbox-prev');
  const lightboxNext = document.getElementById('lightbox-next');

  let lightboxImages: string[] = [];
  let currentLightboxIdx = 0;

  function updateLightboxImageList() {
    lightboxImages = [];
    const activeTabTrigger = document.querySelector('[data-tab-trigger].bg-brand');
    if (activeTabTrigger) {
      const activeTabId = activeTabTrigger.getAttribute('data-tab-trigger');
      const activePanel = document.getElementById(activeTabId || '');
      if (activePanel) {
        const triggers = activePanel.querySelectorAll('[data-lightbox-trigger]');
        triggers.forEach(t => {
          const src = t.getAttribute('data-lightbox-trigger');
          if (src) lightboxImages.push(src);
        });
      }
    }
  }

  function showLightboxImage(index: number) {
    if (!lightboxImages.length || !lightboxImg) return;
    currentLightboxIdx = (index + lightboxImages.length) % lightboxImages.length;

    lightboxImg.classList.remove('opacity-100');
    lightboxImg.classList.add('opacity-0');

    setTimeout(() => {
      if (lightboxImg) {
        lightboxImg.src = lightboxImages[currentLightboxIdx];
        lightboxImg.onload = () => {
          lightboxImg.classList.remove('opacity-0');
          lightboxImg.classList.add('opacity-100');
        };
      }
    }, 150);
  }

  function openLightbox(src: string) {
    updateLightboxImageList();
    const idx = lightboxImages.indexOf(src);
    if (idx !== -1) {
      currentLightboxIdx = idx;
    }

    lightboxModal?.classList.remove('pointer-events-none', 'opacity-0');
    lightboxModal?.classList.add('opacity-100');
    document.body.style.overflow = 'hidden';
    showLightboxImage(currentLightboxIdx);
  }

  function closeLightbox() {
    lightboxModal?.classList.remove('opacity-100');
    lightboxModal?.classList.add('pointer-events-none', 'opacity-0');
    document.body.style.overflow = '';
  }

  // Uỷ quyền sự kiện (Event Delegation) cho click lightbox để hoạt động tốt khi chuyển Tab
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    const trigger = target?.closest('[data-lightbox-trigger]');
    if (trigger) {
      const src = trigger.getAttribute('data-lightbox-trigger');
      if (src) openLightbox(src);
    }
  });

  lightboxClose?.addEventListener('click', closeLightbox);
  lightboxModal?.addEventListener('click', (e) => {
    if (e.target === lightboxModal) closeLightbox();
  });

  lightboxPrev?.addEventListener('click', (e) => {
    e.stopPropagation();
    showLightboxImage(currentLightboxIdx - 1);
  });

  lightboxNext?.addEventListener('click', (e) => {
    e.stopPropagation();
    showLightboxImage(currentLightboxIdx + 1);
  });

  window.addEventListener('keydown', (e) => {
    if (!lightboxModal || lightboxModal.classList.contains('opacity-0')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') showLightboxImage(currentLightboxIdx - 1);
    if (e.key === 'ArrowRight') showLightboxImage(currentLightboxIdx + 1);
  });
</script>
