---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

const { 
  title = "Cho thuê xe du lịch Nha Trang - Nhà Xe Gia Huy Báo giá mới nhất", 
  description = "Cho thuê xe du lịch Nha Trang, Gọi ☎️ 0935.37.3577 ✅ Cam kết giá tốt nhất ⭐chúng tôi có xe ôtô 4,7,16,29,35 đến 45 chỗ ⭐️ phục vụ tất cả các nhu cầu ✅ Đội ngũ lái xe kinh nghiệm, phục vụ tận tình vui vẻ",
  keywords = "xe du lich nha trang, thue xe du lich nha trang, cho thue xe nha trang, thue xe du lich gia huy"
} = Astro.props;
---

<!doctype html>
<html lang="vi" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/uploads/iconkigi.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://xedulichgiahuy.com/" />
    <meta property="og:image" content="/uploads/logo.png" />
    <meta property="og:site_name" content="Xe du lịch Gia Huy Nha Trang" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Chakra+Petch:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </head>
  <body class="flex flex-col min-h-screen text-slate-800 bg-slate-50 font-sans">
    
    <!-- Sticky Glassmorphic Header -->
    <Header />
    
    <!-- Main Content -->
    <main class="flex-grow pt-16 md:pt-20">
      <slot />
    </main>
    
    <!-- Footer Section -->
    <Footer />
    
    <!-- Floating Widgets & Back to Top on the bottom right -->
    <div class="fixed bottom-6 right-6 z-50 flex flex-col gap-3.5 items-center">
      <!-- Back to Top Button -->
      <button id="back-to-top" class="hidden size-12 items-center justify-center rounded-full bg-white border border-slate-200 text-slate-600 hover:text-brand hover:border-brand shadow-premium transition-all duration-300 hover:scale-110" title="Cuộn lên đầu">
        <i class="fa-solid fa-chevron-up"></i>
      </button>

      <!-- Zalo Chat -->
      <a href="https://zalo.me/0935373577" target="_blank" rel="noopener noreferrer" class="flex size-12 items-center justify-center bg-[#0068FF] text-white rounded-full shadow-lg hover:scale-110 hover:bg-[#0056D6] transition-all duration-300" title="Nhắn tin Zalo">
        <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2C6.47715 2 2 6.47715 2 12C2 14.7255 3.09032 17.1962 4.85857 19H4.85C5.12076 19 5.38578 19.1124 5.5746 19.3093L7.7554 21.5834C8.15049 21.9954 8.82367 21.9056 9.10271 21.4038L10.3787 19.1089C10.5187 18.857 10.7818 18.7 11.069 18.7H12C17.5228 18.7 22 14.2228 22 8.7C22 3.17715 17.5228 2 12 2Z" fill="currentColor"/>
          <path d="M9 8H15L10 14H15V16H8V14L13 8H9V8Z" fill="#0068FF"/>
        </svg>
      </a>
      
      <!-- SMS -->
      <a href="sms:0935373577" class="flex size-12 items-center justify-center bg-emerald-500 text-white rounded-full shadow-lg hover:scale-110 hover:bg-emerald-600 transition-all duration-300" title="Gửi SMS">
        <i class="fa-solid fa-envelope text-lg"></i>
      </a>

      <!-- Hotline Call -->
      <a href="tel:0935373577" class="relative flex size-12 items-center justify-center bg-brand-gradient hover:bg-brand-glow text-white rounded-full shadow-glow hover:scale-110 transition-all duration-300" title="Gọi hotline: 0935.37.3577">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-cyan opacity-40"></span>
        <i class="fa-solid fa-phone text-lg animate-bounce"></i>
      </a>
    </div>

    <script>
      const backToTopBtn = document.getElementById('back-to-top');
      if (backToTopBtn) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 400) {
            backToTopBtn.classList.remove('hidden');
            backToTopBtn.classList.add('flex');
          } else {
            backToTopBtn.classList.remove('flex');
            backToTopBtn.classList.add('hidden');
          }
        });
        backToTopBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    </script>
  </body>
</html>
